# ============================================================
# Banco — Supabase (Sprint 1 Sessao 2)
# ============================================================
# Copie em Supabase > Project Settings > Database > Connection string.
# DATABASE_URL usa o pooler (porta 6543) — recomendado para a app.
# DIRECT_URL usa a conexao direta (porta 5432) — usado por Prisma Migrate.
DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres"

# ============================================================
# Auth.js v5 (Sprint 1 Sessao 3)
# ============================================================
# Gere com: npx auth secret
AUTH_SECRET=""

# URL canonica da app. Em dev o Auth.js auto-detecta; defina em producao.
# AUTH_URL="https://crm-squad-five.vercel.app"

# Em deploys que NAO sao Vercel, descomente:
# AUTH_TRUST_HOST=true

# Google OAuth — Console: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Restricao de dominio aceito no login. Apenas e-mails @{AUTH_ALLOWED_DOMAIN}
# conseguem autenticar. Deixe vazio para aceitar qualquer dominio (nao
# recomendado em producao).
AUTH_ALLOWED_DOMAIN="e3digital.com"

# ============================================================
# Observabilidade — libs já instaladas, basta colocar as chaves
# ============================================================
# Sentry: criar projeto em https://sentry.io e copiar DSN do projeto Next.js
SENTRY_DSN=""

# PostHog: https://posthog.com → Project Settings → API Key
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Resend — emails transacionais
# https://resend.com → API keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Squad Five <no-reply@e3digital.com>"
